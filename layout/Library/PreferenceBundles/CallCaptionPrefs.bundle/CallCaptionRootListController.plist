		<string>Engine</string>
		<key>label</key>
		<string>引擎</string>
		<key>validValues</key>
		<array>
			<string>auto</string>
			<string>deepl</string>
			<string>google</string>
			<string>ai</string>
		</array>
		<key>validTitles</key>
		<array>
			<string>自动（推荐）</string>
			<string>DeepL</string>
			<string>Google（免费）</string>
			<string>AI 自定义接口</string>
		</array>
		<key>PostNotification</key>
		<string>net.user.callcaption.prefschanged</string>
	</dict>
	<dict>
		<key>cell</key>
		<string>PSEditTextCell</string>
		<key>default</key>
		<string></string>
		<key>defaults</key>
		<string>net.user.callcaption</string>
		<key>key</key>
		<string>DeepLKey</string>
		<key>label</key>
		<string>DeepL API Key（可留空）</string>
		<key>isSecure</key>
		<true/>
		<key>PostNotification</key>
		<string>net.user.callcaption.prefschanged</string>
	</dict>

	<dict>
		<key>cell</key>
		<string>PSGroupCell</string>
		<key>label</key>
		<string>AI 自定义接口（OpenAI 兼容）</string>
		<key>footerText</key>
		<string>填写 chat/completions 完整地址、API Key 与模型名。示例：https://api.deepseek.com/v1/chat/completions + deepseek-chat。</string>
	</dict>
	<dict>
		<key>cell</key>
		<string>PSEditTextCell</string>
		<key>default</key>
		<string>https://api.deepseek.com/v1/chat/completions</string>
		<key>defaults</key>
		<string>net.user.callcaption</string>
		<key>key</key>
		<string>AIURL</string>
		<key>label</key>
		<string>AI 接口地址</string>
		<key>PostNotification</key>
		<string>net.user.callcaption.prefschanged</string>
	</dict>
	<dict>
		<key>cell</key>
		<string>PSEditTextCell</string>
		<key>default</key>
		<string></string>
		<key>defaults</key>
		<string>net.user.callcaption</string>
		<key>key</key>
		<string>AIKey</string>
		<key>label</key>
		<string>AI API Key</string>
		<key>isSecure</key>
		<true/>
		<key>PostNotification</key>
		<string>net.user.callcaption.prefschanged</string>
	</dict>
	<dict>
		<key>cell</key>
		<string>PSEditTextCell</string>
		<key>default</key>
