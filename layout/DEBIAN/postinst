#!/bin/sh
# CallCaption v0.10.1 — 修复守护进程/LaunchDaemon 所有权（云端构建机产出 owner=501，launchd 会拒绝加载）
JB=/var/jb

chown 0:0 "$JB/usr/local/bin/CallCaptionAudioService" 2>/dev/null || true
chmod 0755 "$JB/usr/local/bin/CallCaptionAudioService" 2>/dev/null || true
chown 0:0 "$JB/Library/LaunchDaemons/net.user.callcaption.audioservice.plist" 2>/dev/null || true
chmod 0644 "$JB/Library/LaunchDaemons/net.user.callcaption.audioservice.plist" 2>/dev/null || true

# 清掉旧版本遗留在错误路径的 Prefs bundle（Preferences 可能优先加载旧副本 → 一直闪退）
rm -rf "$JB/CallCaptionPrefs.bundle" 2>/dev/null || true

# 升级时让新二进制立即生效（launchd KeepAlive 会自动拉起新版）
killall -9 CallCaptionAudioService 2>/dev/null || true

# 立即加载（部分环境不支持 bootstrap，则等用户空间重启自动加载）
launchctl bootstrap system "$JB/Library/LaunchDaemons/net.user.callcaption.audioservice.plist" >/dev/null 2>&1 \
  || launchctl load "$JB/Library/LaunchDaemons/net.user.callcaption.audioservice.plist" >/dev/null 2>&1 \
  || true


# alpha3：不再在安装时强杀 mediaserverd/audiomxd。
# alpha2 这么干之后，通话建立阶段 mediaserverd 被看门狗判定卡死（0x8BADF00D），
# 拨号直接拨不出去。新钩子只在“重启用户空间”后自然加载，安装脚本不碰音频栈。
KILLALL=/var/jb/usr/bin/killall
[ -x "$KILLALL" ] || KILLALL=/usr/bin/killall
[ -x "$KILLALL" ] || KILLALL=killall
"$KILLALL" -9 CallCaptionAudioService 2>/dev/null || true

exit 0
