#!/bin/sh
# CallCaption Pro 1.0.0-pro1.2
# 独立包：安装时暂停稳定版（0.20.7.1）的注入/守护进程/设置入口，
# 卸载时自动恢复稳定版。稳定版文件、配置、日志都不删除。
JB=/var/jb
LOG=/tmp/callcaptionpro_install.log

log() { echo "[$(date '+%F %T')] $*" >> "$LOG" 2>/dev/null || true; }
KILLALL=/var/jb/usr/bin/killall
[ -x "$KILLALL" ] || KILLALL=/usr/bin/killall
[ -x "$KILLALL" ] || KILLALL=killall

log "pro postinst start"

# Pro 运行目录：daemon/helper 以 mobile 运行，Settings 也在 mobile 沙盒，
# 模型包可能已由 dpkg 以 root 创建该目录，必须统一交回 mobile 可写。
mkdir -p /var/mobile/Library/CallCaptionPro
chown -R mobile:mobile /var/mobile/Library/CallCaptionPro 2>/dev/null || true
chmod 0755 /var/mobile/Library/CallCaptionPro 2>/dev/null || true

# Pro daemon 所有权/权限
chown 0:0 "$JB/usr/local/bin/CallCaptionProAudioService" 2>/dev/null || true
chmod 0755 "$JB/usr/local/bin/CallCaptionProAudioService" 2>/dev/null || true
chown 0:0 "$JB/usr/local/bin/CallCaptionProASR" 2>/dev/null || true
chmod 0755 "$JB/usr/local/bin/CallCaptionProASR" 2>/dev/null || true
chown 0:0 "$JB/Library/Frameworks/SherpaOnnxC.framework/SherpaOnnxC" 2>/dev/null || true
chmod 0755 "$JB/Library/Frameworks/SherpaOnnxC.framework/SherpaOnnxC" 2>/dev/null || true
chown 0:0 "$JB/Library/LaunchDaemons/net.user.callcaptionpro.audioservice.plist" 2>/dev/null || true
chmod 0644 "$JB/Library/LaunchDaemons/net.user.callcaptionpro.audioservice.plist" 2>/dev/null || true

# Pro prefs bundle：清掉遗留的“类名 plist”（已知闪退源）
B="$JB/Library/PreferenceBundles/CallCaptionProPrefs.bundle"
if [ -d "$B" ]; then
  find "$B" -maxdepth 1 -name "*.plist" ! -name "Root.plist" ! -name "Info.plist" -delete 2>/dev/null || true
fi

# 暂停稳定版：先停 daemon（bootout 失败时用 disable，防止 KeepAlive 再拉起）
launchctl bootout system/net.user.callcaption.audioservice >/dev/null 2>&1 || true
launchctl disable system/net.user.callcaption.audioservice >/dev/null 2>&1 || true
"$KILLALL" -9 CallCaptionAudioService >/dev/null 2>&1 || true

# 暂停稳定版注入/设置/daemon 自启（只改名，不删除）
for f in CallCaption.plist CallCaptionAppProbe.plist CallCaptionAudioHook.plist; do
  P="$JB/Library/MobileSubstrate/DynamicLibraries/$f"
  if [ -f "$P" ]; then
    mv -f "$P" "$P.disabled" 2>/dev/null && log "disabled $f"
  fi
done
P="$JB/Library/LaunchDaemons/net.user.callcaption.audioservice.plist"
if [ -f "$P" ]; then
  mv -f "$P" "$P.disabled" 2>/dev/null && log "disabled stable daemon plist"
fi
P="$JB/Library/PreferenceLoader/Preferences/callcaption.plist"
if [ -f "$P" ]; then
  mv -f "$P" "$P.disabled" 2>/dev/null && log "disabled stable settings entry"
fi
# PreferenceLoader 会把旧条目缓存在 Preferences 进程里，杀掉才能立刻消失
"$KILLALL" -9 Preferences >/dev/null 2>&1 || true

# 启动 Pro daemon
# 覆盖安装时同名 label 可能还在跑 pro0.1；bootstrap 会失败，旧进程继续运行。
# killall 对超过 15 字符的进程名不可靠，必须先按 label bootout 再 bootstrap。
launchctl bootout system/net.user.callcaptionpro.audioservice >/dev/null 2>&1 || true
sleep 1
launchctl enable system/net.user.callcaptionpro.audioservice >/dev/null 2>&1 || true
launchctl bootstrap system "$JB/Library/LaunchDaemons/net.user.callcaptionpro.audioservice.plist" >/dev/null 2>&1 \
  || launchctl load "$JB/Library/LaunchDaemons/net.user.callcaptionpro.audioservice.plist" >/dev/null 2>&1 \
  || true
sleep 1
launchctl print system/net.user.callcaptionpro.audioservice 2>/dev/null \
  | grep -E "state =|pid =" >> "$LOG" 2>/dev/null || true

# 让 Pro SpringBoard/AppProbe 立刻加载
"$KILLALL" -9 WhatsApp >/dev/null 2>&1 || true
"$KILLALL" -9 SpringBoard >/dev/null 2>&1 || true
log "pro postinst done"
exit 0
