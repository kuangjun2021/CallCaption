		<key>label</key>
		<string>大字幕</string>
		<key>PostNotification</key>
		<string>net.user.callcaption.prefschanged</string>
	</dict>

	<dict>
		<key>cell</key>
		<string>PSGroupCell</string>
		<key>label</key>
		<string>语言</string>
		<key>footerText</key>
		<string>识别语言代码（BCP-47）。对方英文填 en-US，对方日文填 ja-JP；我的语言通常 zh-CN。目标语言固定：对方→中文，我方→英文。</string>
	</dict>
	<dict>
		<key>cell</key>
		<string>PSEditTextCell</string>
		<key>default</key>
		<string>en-US</string>
		<key>defaults</key>
		<string>net.user.callcaption</string>
		<key>key</key>
		<string>RemoteLocale</string>
		<key>label</key>
		<string>对方语言（如 en-US）</string>
		<key>PostNotification</key>
		<string>net.user.callcaption.prefschanged</string>
