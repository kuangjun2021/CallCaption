<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<array>
	<dict>
		<key>cell</key>
		<string>PSGroupCell</string>
		<key>label</key>
		<string>功能开关</string>
		<key>footerText</key>
		<string>通话接通后屏幕右下出现“译”按钮，点按开/关翻译，长按弹菜单。字幕可拖动，双击折叠。</string>
	</dict>
	<dict>
		<key>cell</key>
		<string>PSSwitchCell</string>
		<key>default</key>
		<true/>
		<key>defaults</key>
		<string>net.user.callcaption</string>
		<key>key</key>
		<string>Enabled</string>
		<key>label</key>
		<string>启用 CallCaption</string>
		<key>PostNotification</key>
		<string>net.user.callcaption.prefschanged</string>
	</dict>
	<dict>
		<key>cell</key>
		<string>PSSwitchCell</string>
		<key>default</key>
		<true/>
		<key>defaults</key>
		<string>net.user.callcaption</string>
		<key>key</key>
		<string>RemoteEnabled</string>
		<key>label</key>
		<string>对方语音 → 中文字幕</string>
		<key>PostNotification</key>
		<string>net.user.callcaption.prefschanged</string>
	</dict>
	<dict>
		<key>cell</key>
		<string>PSSwitchCell</string>
		<key>default</key>
		<false/>
		<key>defaults</key>
		<string>net.user.callcaption</string>
		<key>key</key>
		<string>LocalEnabled</string>
		<key>label</key>
		<string>双向模式：我的话 → 英文播报</string>
		<key>PostNotification</key>
		<string>net.user.callcaption.prefschanged</string>
	</dict>
	<dict>
		<key>cell</key>
		<string>PSSwitchCell</string>
		<key>default</key>
		<true/>
		<key>defaults</key>
		<string>net.user.callcaption</string>
		<key>key</key>
		<string>TTSEnabled</string>
		<key>label</key>
		<string>中文字幕语音播报</string>
		<key>PostNotification</key>
		<string>net.user.callcaption.prefschanged</string>
	</dict>
	<dict>
		<key>cell</key>
		<string>PSSwitchCell</string>
		<key>default</key>
		<false/>
		<key>defaults</key>
		<string>net.user.callcaption</string>
