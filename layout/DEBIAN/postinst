#!/bin/sh
# CallCaption Pro 1.0.0-pro2.1.16 postinst
#
# 安装脚本必须快速、完整地结束。这里只做两件事：
#   1. 确保 Pro 运行目录可写；
#   2. 启动/重启 Pro 守护进程。
# 不杀 Preferences / WhatsApp / SpringBoard，不做 sleep 轮询，
# 这样 Sileo 才能正常显示“执行→完成→手动注销”。
set +e

JB=/var/jb
DIR=/var/mobile/Library/CallCaptionPro
LOG="$DIR/install.log"

mkdir -p "$DIR" 2>/dev/null || true
chown mobile:mobile "$DIR" 2>/dev/null || true
chmod 0755 "$DIR" 2>/dev/null || true
: >> "$LOG" 2>/dev/null || true
chmod 0666 "$LOG" 2>/dev/null || true

log() { echo "[$(date '+%F %T')] $*" >> "$LOG" 2>/dev/null || true; }

LABEL=net.user.callcaptionpro.audioservice
PLIST="$JB/Library/LaunchDaemons/net.user.callcaptionpro.audioservice.plist"

log "pro postinst start (2.1.16)"

launchctl enable "system/$LABEL" >/dev/null 2>&1 || true
if launchctl print "system/$LABEL" >/dev/null 2>&1; then
  launchctl kickstart -k "system/$LABEL" >>"$LOG" 2>&1
  log "kickstart rc=$?"
else
  launchctl bootstrap system "$PLIST" >>"$LOG" 2>&1
  RC=$?
  log "bootstrap rc=$RC"
  if [ "$RC" -ne 0 ]; then
    launchctl load "$PLIST" >>"$LOG" 2>&1
    log "load rc=$?"
  fi
fi

log "pro postinst done"
exit 0
